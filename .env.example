# Copy to .env. The launcher loads these keys without executing shell code.
REFIT_AI_PROVIDER=ollama
REFIT_OLLAMA_URL=http://127.0.0.1:11434
REFIT_OLLAMA_MODEL=qwen3-vl:4b
REFIT_AI_TIMEOUT_SECONDS=45
# Optional cloud provider. Explicit per-analysis cloud consent is still required.
REFIT_GEMINI_MODEL=
GEMINI_API_KEY=
# REFIT_DATA_DIR=var
